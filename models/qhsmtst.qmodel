<?xml version="1.0" encoding="UTF-8"?>
<model format="qmodel-1" framework="qpc">

<package name="SMs">

<class name="QHsmTst" super="QHsm">
    <doc><![CDATA[
QHsmTst is a contrived state machine from Chapter 2 of the
PSiCC2 book for testing all possible transition topologies
with up to 4-levels of state nesting.
    ]]></doc>

    <attribute name="foo" type="uint8_t" visibility="private"/>

<statechart>
    <initial target="s2">
    <action><![CDATA[
Q_UNUSED_PAR(par);
me->foo = 0U;
BSP_display("top-INIT;");

QS_SIG_DICTIONARY(A_SIG, (void *)0);
QS_SIG_DICTIONARY(B_SIG, (void *)0);
QS_SIG_DICTIONARY(C_SIG, (void *)0);
QS_SIG_DICTIONARY(D_SIG, (void *)0);
QS_SIG_DICTIONARY(E_SIG, (void *)0);
QS_SIG_DICTIONARY(F_SIG, (void *)0);
QS_SIG_DICTIONARY(G_SIG, (void *)0);
QS_SIG_DICTIONARY(H_SIG, (void *)0);
QS_SIG_DICTIONARY(I_SIG, (void *)0);
QS_SIG_DICTIONARY(IGNORE_SIG,    (void *)0);
QS_SIG_DICTIONARY(TERMINATE_SIG, (void *)0);
    ]]></action>
    </initial>

<state name="s">
    <entry><![CDATA[
BSP_display("s-ENTRY;");
    ]]></entry>
    <exit><![CDATA[
BSP_display("s-EXIT;");
    ]]></exit>
    <initial target="s11">
    <action><![CDATA[
BSP_display("s-INIT;");
    ]]></action>
    </initial>
    <tran trig="I">
    <choice>
    <guard><![CDATA[
me->foo
    ]]></guard>
    <action><![CDATA[
me->foo = 0U;
BSP_display("s-I;");
    ]]></action>
    </choice>
    </tran>
    <tran trig="E" target="s11">
    <action><![CDATA[
BSP_display("s-E;");
    ]]></action>
    </tran>
    <tran trig="TERMINATE">
    <action><![CDATA[
BSP_terminate(0);
    ]]></action>
    </tran>
</state>

<state name="s1" super="s">
    <entry><![CDATA[
BSP_display("s1-ENTRY;");
    ]]></entry>
    <exit><![CDATA[
BSP_display("s1-EXIT;");
    ]]></exit>
    <initial target="s11">
    <action><![CDATA[
BSP_display("s1-INIT;");
    ]]></action>
    </initial>
    <tran trig="I">
    <action><![CDATA[
BSP_display("s1-I;");
    ]]></action>
    </tran>
    <tran trig="D">
    <choice target="s">
    <guard><![CDATA[
!me->foo
    ]]></guard>
    <action><![CDATA[
me->foo = 1U;
BSP_display("s1-D;");
    ]]></action>
    </choice>
    </tran>
    <tran trig="A" target="s1">
    <action><![CDATA[
BSP_display("s1-A;");
    ]]></action>
    </tran>
    <tran trig="B" target="s11">
    <action><![CDATA[
BSP_display("s1-B;");
    ]]></action>
    </tran>
    <tran trig="F" target="s211">
    <action><![CDATA[
BSP_display("s1-F;");
    ]]></action>
    </tran>
    <tran trig="C" target="s2">
    <action><![CDATA[
BSP_display("s1-C;");
    ]]></action>
    </tran>
</state>

<state name="s11" super="s1">
    <entry><![CDATA[
BSP_display("s11-ENTRY;");
    ]]></entry>
    <exit><![CDATA[
BSP_display("s11-EXIT;");
    ]]></exit>
    <tran trig="H" target="s">
    <action><![CDATA[
BSP_display("s11-H;");
    ]]></action>
    </tran>
    <tran trig="D">
    <choice target="s1">
    <guard><![CDATA[
me->foo
    ]]></guard>
    <action><![CDATA[
me->foo = 0U;
BSP_display("s11-D;");
    ]]></action>
    </choice>
    </tran>
    <tran trig="G" target="s211">
    <action><![CDATA[
BSP_display("s11-G;");
    ]]></action>
    </tran>
</state>

<state name="s2" super="s">
    <entry><![CDATA[
BSP_display("s2-ENTRY;");
    ]]></entry>
    <exit><![CDATA[
BSP_display("s2-EXIT;");
    ]]></exit>
    <initial target="s211">
    <action><![CDATA[
BSP_display("s2-INIT;");
    ]]></action>
    </initial>
    <tran trig="I">
    <choice>
    <guard><![CDATA[
!me->foo
    ]]></guard>
    <action><![CDATA[
me->foo = 1U;
BSP_display("s2-I;");
    ]]></action>
    </choice>
    </tran>
    <tran trig="F" target="s11">
    <action><![CDATA[
BSP_display("s2-F;");
    ]]></action>
    </tran>
    <tran trig="C" target="s1">
    <action><![CDATA[
BSP_display("s2-C;");
    ]]></action>
    </tran>
</state>

<state name="s21" super="s2">
    <entry><![CDATA[
BSP_display("s21-ENTRY;");
    ]]></entry>
    <exit><![CDATA[
BSP_display("s21-EXIT;");
    ]]></exit>
    <initial target="s211">
    <action><![CDATA[
BSP_display("s21-INIT;");
    ]]></action>
    </initial>
    <tran trig="G" target="s1">
    <action><![CDATA[
BSP_display("s21-G;");
    ]]></action>
    </tran>
    <tran trig="A" target="s21">
    <action><![CDATA[
BSP_display("s21-A;");
    ]]></action>
    </tran>
    <tran trig="B" target="s211">
    <action><![CDATA[
BSP_display("s21-B;");
    ]]></action>
    </tran>
</state>

<state name="s211" super="s21">
    <entry><![CDATA[
BSP_display("s211-ENTRY;");
    ]]></entry>
    <exit><![CDATA[
BSP_display("s211-EXIT;");
    ]]></exit>
    <tran trig="H" target="s">
    <action><![CDATA[
BSP_display("s211-H;");
    ]]></action>
    </tran>
    <tran trig="D" target="s21">
    <action><![CDATA[
BSP_display("s211-D;");
    ]]></action>
    </tran>
</state>
</statechart>
</class>
</package>

</model>
